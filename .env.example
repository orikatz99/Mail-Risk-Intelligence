# =============================================================================
# Mail Risk Intelligence — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# =============================================================================

# LLM Provider: "groq" (default) | "gemini" | "ollama"
LLM_PROVIDER=groq

# ---------------------------------------------------------------------------
# Groq (free tier — default provider)
# Get a free API key at: https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# ---------------------------------------------------------------------------
# Google Gemini (free tier — alternative provider)
# Get a free API key at: https://aistudio.google.com
# Uncomment and set LLM_PROVIDER=gemini to use.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Ollama (fully local — no API key required)
# Install from: https://ollama.com/download
# Run: ollama pull llama3
# Uncomment and set LLM_PROVIDER=ollama to use.
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
